{
  "name": "joa-api",
  "version": "1.0.3",
  "description": "Esta es una api para el proyecto de acortador",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "ts-node-dev src/index.ts",
    "generate": "prisma generate",
    "migrate": "prisma migrate",
    "studio": "prisma studio",
    "format": "prettier --write .",
    "lint": "eslint . ",
    "lint:fix": "eslint . --fix ",
    "release": "standard-version --release-as patch && git push --follow-tags --no-verify",
    "prepare": "husky",
    "pre-commit": "npm run lint && npm run format",
    "pre-push": "npm run release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DairoCantillo/joa-api.git"
  },
  "author": "Dairo Cantillo",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/DairoCantillo/joa-api/issues"
  },
  "homepage": "https://github.com/DairoCantillo/joa-api#readme",
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.23.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "eslint": "^9.23.0",
    "eslint-plugin-react": "^7.37.4",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "prisma": "^5.18.0",
    "standard-version": "^9.5.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.28.0",
    "zod": "^3.23.8"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "bcrypt": "^5.1.1",
    "express": "^4.19.2",
    "express-jwt": "^8.4.1",
    "jsonwebtoken": "^9.0.2"
  }
}
